go 1.27.1

use (
	.
	./programs/classify
	./programs/crucible
)

// programs/classify requires gepago v0.12.0 before it is tagged, and workspace mode still reads
// a required version's go.mod, so the workspace module stands in for it. After tagging v0.12.0,
// run `GOWORK=off go mod tidy` in programs/classify, commit its go.sum and remove this replace
// (CONTRIBUTING.md, Releases).
replace github.com/mikills/gepago v0.12.0 => ./
