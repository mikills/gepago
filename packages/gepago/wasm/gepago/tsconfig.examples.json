{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"],
    "typeRoots": ["../node_modules/@types"],
    "allowImportingTsExtensions": true,
    "paths": {
      "@mikills/wasm/gepago": ["./dist/index.d.ts"],
      "@mikills/wasm/gepago/*": ["./dist/*.d.ts"]
    }
  },
  "include": ["examples/**/*.ts"]
}
