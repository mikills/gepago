{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": ["node"],
    "typeRoots": ["../node_modules/@types"],
    "skipLibCheck": true,
    "strict": true
  },
  "include": ["*.ts", "scripts/**/*.ts"],
  "exclude": ["test", "examples", "dist", ".test-dist", "node_modules"]
}
